GEMINI_API_KEY=your_gemini_api_key_here

# STT (stt.py) 실행 환경 오버라이드. 기본값은 CPU(cpu/int8).
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8

# MySQL 접속 URL (개인화 이력 저장용). SQLAlchemy 형식 한 줄로 지정한다.
# MySQL 미가용이어도 서버는 기동되며 개인화만 생략됨.
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/<database>

# JWT 토큰 서명 키 (회원가입/로그인용).
JWT_SECRET_KEY=your_jwt_secret_key_here

# 장면 인식 AI 서버 (별도 프로세스). AI 서버는 --port 8001 로 띄울 것
# (저장소 기본 포트 8000은 이 백엔드와 충돌).
AI_SERVER_URL=http://localhost:8001
AI_SERVER_TIMEOUT=10
